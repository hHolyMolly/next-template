{
  "name": "next-template",
  "version": "2.3.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "*.css",
    "*.scss"
  ],
  "packageManager": "pnpm@10.26.2",
  "engines": {
    "node": ">=24",
    "pnpm": ">=10.16"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/check-public-env.mjs NEXT_PUBLIC_CLIENT_URL NEXT_PUBLIC_SERVER_URL NEXT_PUBLIC_VITALS_ENDPOINT",
    "start": "next start",
    "preview": "pnpm build && pnpm start",
    "lint": "eslint . --max-warnings 0 --cache --cache-location node_modules/.cache/eslint/",
    "lint:fix": "eslint . --fix --cache --cache-location node_modules/.cache/eslint/",
    "lint:css": "stylelint \"src/**/*.{css,scss}\" --cache --cache-location node_modules/.cache/stylelint/",
    "lint:css:fix": "stylelint \"src/**/*.{css,scss}\" --fix --cache --cache-location node_modules/.cache/stylelint/",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "pnpm lint && pnpm lint:css && pnpm format:check && pnpm typecheck && pnpm typecheck:test && pnpm test && pnpm check:i18n && pnpm knip",
    "check:i18n": "node scripts/check-translations.mjs",
    "analyze": "next experimental-analyze",
    "knip": "knip",
    "clean": "rm -rf .next coverage .vitest",
    "clean:cache": "rm -rf node_modules/.cache .vitest .eslintcache .stylelintcache tsconfig.tsbuildinfo tsconfig.test.tsbuildinfo",
    "clean:demo": "node scripts/clean-demo.mjs",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "@reduxjs/toolkit": "^2.13.0",
    "@tanstack/react-query": "^5.104.1",
    "axios": "^1.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.51.0",
    "next": "16.3.8",
    "next-intl": "^4.14.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.89.0",
    "react-redux": "^9.3.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@next/env": "16.3.8",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/eslint-plugin-query": "^5.104.1",
    "@tanstack/react-query-devtools": "^5.104.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.8",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "knip": "^6.39.0",
    "lint-staged": "^17.6.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sass": "^1.105.1",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
